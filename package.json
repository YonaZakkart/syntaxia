{
  "name": "syntaxia",
  "version": "0.5.0",
  "private": true,
  "description": "AI-powered coding practice platform and online judge.",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm db:generate && pnpm --filter @syntaxia/db build && pnpm -r run dev",
    "dev:worker": "pnpm db:generate && pnpm --filter @syntaxia/db build && pnpm --filter @syntaxia/worker dev",
    "build": "pnpm db:generate && pnpm -r --workspace-concurrency=1 run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r --if-present run test",
    "format": "biome format --write .",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "db:push": "pnpm --filter @syntaxia/db db:push",
    "db:studio": "pnpm --filter @syntaxia/db db:studio",
    "db:generate": "pnpm --filter @syntaxia/db db:generate",
    "db:migrate": "pnpm --filter @syntaxia/db db:migrate",
    "db:seed": "pnpm --filter @syntaxia/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
