{
  "name": "syntaxia",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered coding practice platform and online judge.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @syntaxia/db build && pnpm -r run dev",
    "dev:worker": "pnpm --filter @syntaxia/db build && pnpm --filter @syntaxia/worker dev",
    "build": "pnpm -r run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "db:push": "pnpm --filter @syntaxia/db db:push",
    "db:studio": "pnpm --filter @syntaxia/db db:studio",
    "db:generate": "pnpm --filter @syntaxia/db db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^5.5.0"
  }
}
