{
  "name": "@syntaxia/db",
  "version": "0.7.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "db:generate": "node scripts/run-with-env.cjs prisma generate",
    "db:push": "node scripts/run-with-env.cjs prisma db push",
    "db:studio": "node scripts/run-with-env.cjs prisma studio",
    "db:migrate": "node scripts/run-with-env.cjs prisma migrate dev",
    "db:seed": "node scripts/run-with-env.cjs tsx seed.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.15.0",
    "typescript": "^5.5.0"
  }
}
