generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  PASSED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  SYSTEM_ERROR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("USER") // USER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]
}

model Language {
  id          String   @id @default(uuid())
  name        String   // e.g., "JavaScript", "Python"
  version     String   // e.g., "18.x", "3.11"
  dockerImage String   // e.g., "node:18-alpine", "python:3.11-slim"
  defaultTimeLimitMs      Int @default(5000)
  defaultMemoryLimitMb    Int @default(256)
  defaultOutputLimitBytes Int @default(1048576) // 1 MB per stream
  createdAt   DateTime @default(now())
  
  challenges  Challenge[]
  submissions Submission[]
}

model Challenge {
  id            String     @id @default(uuid())
  title         String
  description   String     @db.Text
  difficulty    String     // EASY, MEDIUM, HARD
  starterCode   String     @db.Text
  languageId    String
  language      Language   @relation(fields: [languageId], references: [id])
  // Per-challenge overrides; null falls back to the language defaults.
  timeLimitMs      Int?
  memoryLimitMb    Int?
  outputLimitBytes Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  testCases     TestCase[]
  submissions   Submission[]
}

model TestCase {
  id             String    @id @default(uuid())
  challengeId    String
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  input          String    @db.Text
  expectedOutput String    @db.Text
  isPublic       Boolean   @default(false) // Public for hints, private for final grading
}

model Submission {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  challengeId String
  challenge   Challenge   @relation(fields: [challengeId], references: [id])
  languageId  String
  language    Language    @relation(fields: [languageId], references: [id])
  code        String      @db.Text
  status      SubmissionStatus @default(QUEUED)
  createdAt   DateTime    @default(now())

  execution   Execution?
}

model Execution {
  id               String     @id @default(uuid())
  submissionId     String     @unique
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testsPassed      Int
  testsTotal       Int
  totalDurationMs  Int
  testResults      Json       // TestResult[] as produced by the test runner
  failedTestCaseId String?
  errorMessage     String?
  createdAt        DateTime   @default(now())
}
