# Server-side API origin used by the Next.js proxy (rewrites).
# The browser calls relative /api/* paths, so cookies stay same-origin.
API_URL=http://localhost:3001

# Backend API exposed to the browser (kept for direct calls when needed)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Future real-time transport (reserved; polling is used for now)
NEXT_PUBLIC_WS_URL=ws://localhost:3001
